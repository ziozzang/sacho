{
  "uid": "sacho-overview",
  "title": "Sacho overview",
  "tags": [
    "sacho"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(sacho_check_status, group)",
          "refId": "group"
        },
        "definition": "label_values(sacho_check_status, group)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "check",
        "label": "Check",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(sacho_check_status{group=~\"$group\"}, name)",
          "refId": "check"
        },
        "definition": "label_values(sacho_check_status{group=~\"$group\"}, name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Down or degraded now",
      "type": "stat",
      "description": "Checks that are not up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sacho_check_status{group=~\"$group\",name=~\"$check\"} == 1 or sacho_check_status{group=~\"$group\",name=~\"$check\"} == 2) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Open incidents",
      "type": "stat",
      "description": "Automatically detected incidents that have not been resolved.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sacho_check_incident_open{group=~\"$group\",name=~\"$check\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Availability in the selected range",
      "type": "gauge",
      "description": "Share of the selected time during which checks were up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time(sacho_check_up{group=~\"$group\",name=~\"$check\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Slowest check now",
      "type": "stat",
      "description": "Longest response time of the latest observations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sacho_check_latency_seconds{group=~\"$group\",name=~\"$check\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Check status",
      "type": "table",
      "description": "One row per check. The text columns come from the sacho_check_info labels.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sacho_check_status{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sacho_check_info{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sacho_check_latency_seconds{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sacho_check_consecutive_failures{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "name 1": true,
              "group 1": true,
              "check_type 1": true,
              "visibility 1": true,
              "Value #A": true,
              "display_value": true,
              "message": true,
              "Value #C": true,
              "Value #D": true
            },
            "indexByName": {
              "name 1": 0,
              "group 1": 1,
              "Value #A": 2,
              "display_value": 3,
              "message": 4,
              "Value #C": 5,
              "Value #D": 6,
              "check_type 1": 7,
              "visibility 1": 8
            },
            "renameByName": {
              "name 1": "Check",
              "group 1": "Group",
              "check_type 1": "Type",
              "visibility 1": "Visibility",
              "Value #A": "State",
              "display_value": "Value",
              "message": "Message",
              "Value #C": "Response time",
              "Value #D": "Failures in a row"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "up",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "degraded",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "down",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "unknown",
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Response time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Status over time",
      "type": "state-timeline",
      "description": "Published state of each check over the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sacho_check_status{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "up",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "degraded",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "down",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "unknown",
                  "color": "text",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never"
      }
    },
    {
      "id": 7,
      "title": "Response time",
      "type": "timeseries",
      "description": "Response time of each observation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sacho_check_latency_seconds{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Numeric values",
      "type": "timeseries",
      "description": "Numbers published by checks that have value publishing turned on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sacho_check_value{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}} {{unit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Observations per minute",
      "type": "timeseries",
      "description": "How often checks ran, by group.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group) (rate(sacho_check_runs_total{group=~\"$group\",name=~\"$check\"}[$__rate_interval])) * 60",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Time since last success",
      "type": "timeseries",
      "description": "Seconds since each check was last up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - sacho_check_last_success_timestamp_seconds{group=~\"$group\",name=~\"$check\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
